#!/usr/bin/env bash
# 不搶焦點的 Google Chrome：用法跟 Chrome 執行檔一樣（chrome-bg --remote-debugging-port=… …）。
#
# 為什麼要複製一份：給「非要有視窗不可」的自動化用（小說抓取：Cloudflare 擋 headless）。
# 2026-10-15 實測 Chrome 啟動後約 2 秒會自己跳到前面 2～3 秒，`open -g`、`open -g -j` 都擋不住；
# 用 CDP 開前景分頁也會再搶一次。正版 Chrome 帶 hardened runtime，DYLD_INSERT_LIBRARIES 注入不進去，
# 所以複製一份（APFS clone，幾乎不佔空間）、用 ad-hoc 重新簽章拿掉 hardened runtime，
# 再注入跟 godot-bg 同一支 nofocus.dylib。使用者 2026-10-15 選了這個做法。
#
# - 副本在 ~/Library/Caches/nofocus-chrome/，正版 Chrome 一更新（版本號不同）下次啟動就自動重做。
# - 強制帶 --use-mock-keychain：副本簽章跟正版不同，碰鑰匙圈的「Chrome Safe Storage」會跳密碼框。
#   代價是那個 profile 舊的 cookie 解不開，網站驗證會重過一次。
# - 做不出副本就照常跑正版（不擋工作），呼叫端原本的「縮到 Dock」仍然有效。
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="/Applications/Google Chrome.app"
CACHE="$HOME/Library/Caches/nofocus-chrome"
APP="$CACHE/Google Chrome.app"
BIN="Contents/MacOS/Google Chrome"
LOG="$CACHE/build.log"

ver() { /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null; }

build() {
  mkdir -p "$CACHE"
  {
    echo "== $(date '+%F %T') 重做副本：$(ver "$SRC")"
    rm -rf "$APP.tmp"
    cp -cR "$SRC" "$APP.tmp" || return 1
    # 只留現役版本的 framework，舊版的不用簽
    local cur; cur=$(ver "$SRC")
    for v in "$APP.tmp/Contents/Frameworks/Google Chrome Framework.framework/Versions/"*/; do
      case "$(basename "$v")" in "$cur"|Current) ;; *) rm -rf "$v" ;; esac
    done
    # 拿掉 hardened runtime：ad-hoc 重簽、不帶 --options runtime（先清 xattr，不然 codesign 拒簽）
    xattr -cr "$APP.tmp"
    codesign --force --deep --sign - "$APP.tmp" || return 1
    rm -rf "$APP" && mv "$APP.tmp" "$APP"
  } >>"$LOG" 2>&1
}

[ -f "$DIR/nofocus.dylib" ] || "$DIR/build.sh" >/dev/null 2>&1 || true
if [ "$(uname)" = Darwin ] && [ -f "$DIR/nofocus.dylib" ]; then
  if [ "$(ver "$APP")" != "$(ver "$SRC")" ] || [ ! -x "$APP/$BIN" ]; then
    build || echo "chrome-bg：副本做不出來，改跑正版（見 ${LOG}）" >&2
  fi
  if [ -x "$APP/$BIN" ] && [ "$(ver "$APP")" = "$(ver "$SRC")" ]; then
    export DYLD_INSERT_LIBRARIES="$DIR/nofocus.dylib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
    exec "$APP/$BIN" --use-mock-keychain "$@"
  fi
fi
exec "$SRC/$BIN" "$@"
