#!/usr/bin/env bash
# 不搶焦點的 Godot：注入 nofocus.dylib 後 exec 真正的 Godot。
# hooks/focus-guard.mjs 在 agent 的指令前面補 `export GODOT=<這支>`，所以任何分支的 run.sh（用 ${GODOT:-…}）都自動走它。
# dylib 還沒建就先建；建不起來就照常跑（不擋工作），focus-keeper 仍會事後切回。
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL="${GODOT_REAL:-/Applications/Godot.app/Contents/MacOS/Godot}"
# 新版 run.sh 會把 $GODOT 當 GODOT_REAL 傳進來；GODOT 已經是這支時就是指回自己，exec 會無限迴圈
[ "$REAL" -ef "${BASH_SOURCE[0]}" ] && REAL=/Applications/Godot.app/Contents/MacOS/Godot
[ -f "$DIR/nofocus.dylib" ] || "$DIR/build.sh" >/dev/null 2>&1 || true
if [ -f "$DIR/nofocus.dylib" ]; then
  export DYLD_INSERT_LIBRARIES="$DIR/nofocus.dylib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
fi
# agent 跑的 Godot 一律不出聲（2026-10-20 使用者：「animyria測試的時候不要發出聲音 以目前所有測試都不要」）。
# 要聽聲音才設 GODOT_SOUND=1。參數放最前面，`--` 之後的驅動器參數不受影響。
if [ "${GODOT_SOUND:-}" = 1 ]; then
  exec "$REAL" "$@"
fi
exec "$REAL" --audio-driver Dummy "$@"
