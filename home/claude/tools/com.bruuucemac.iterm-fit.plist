<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bruuucemac.iterm-fit</string>
  <!-- 新開的 iTerm2 視窗照所在螢幕調大小（四宮格填滿、一般視窗較小），說明在 iterm-fit.js 檔頭。
       正本在 ~/.claude/skills/home/claude/tools/，安裝：
         cp 這個檔 ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bruuucemac.iterm-fit.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/osascript</string>
    <string>-l</string>
    <string>JavaScript</string>
    <string>/Users/bruuucemac/.claude/skills/home/claude/tools/iterm-fit.js</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/bruuucemac/.claude/logs/iterm-fit.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bruuucemac/.claude/logs/iterm-fit.log</string>
</dict>
</plist>
