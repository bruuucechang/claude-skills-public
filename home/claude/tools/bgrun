#!/usr/bin/env bash
# bgrun <指令…> —— 跑一個會開視窗的程式，但不讓它搶走使用者的焦點。
#
# 為什麼要這支：有些程式（Godot 就是）啟動時自己呼叫 activate，
# `open -g` 和 Godot 的 window/size/no_focus 都擋不住（2026-10-11 實測）。
# 做法：先記下現在最前面的 app，啟動後的頭 BGRUN_GUARD 秒內，
# 只要最前面變成「不是原本那個」且是我們啟動的程式，就把原本那個切回來。
# 代價（實測）：每次被搶約 0.2 秒才切回，Godot 會搶兩次；那瞬間打的字可能進到新視窗。
# 原生的 NSRunningApplication.activate 一樣快但前幾次會被系統忽略，所以用 Apple Event。
# 守衛期間你自己點那個新視窗也會被切回去——要用它就等幾秒，或設 BGRUN_GUARD=0。
# 除錯：BGRUN_LOG=<檔案> 會記下每次「被搶／切回」的毫秒時間。
#
# 會 exec 成目標指令（pid 不變），所以可以直接換掉腳本裡的 `exec "$GODOT" …`。
# 非 macOS 直接 exec，不做任何事。
set -euo pipefail
[ "$#" -gt 0 ] || { echo "用法：bgrun <指令…>" >&2; exit 2; }
if [ "$(uname -s)" != Darwin ]; then exec "$@"; fi

guard="${BGRUN_GUARD:-8}"   # 秒；Godot 會在 0 與約 1.3 秒各搶一次
target_pid=$$   # exec 之後這個 pid 就是目標程式
prev=$(osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSWorkspace.sharedWorkspace.frontmostApplication.processIdentifier' 2>/dev/null || echo 0)

if [ "$prev" != 0 ] && [ "$guard" != 0 ]; then
  osascript -l JavaScript - "$prev" "$target_pid" "$guard" "${BGRUN_LOG:-}" >/dev/null 2>&1 <<'JXA' &
ObjC.import("AppKit");
function run(argv) {
  const prev = +argv[0], target = +argv[1], until = Date.now() + (+argv[2]) * 1000;
  const ws = $.NSWorkspace.sharedWorkspace;
  const prevId = $.NSRunningApplication.runningApplicationWithProcessIdentifier(prev).bundleIdentifier.js;
  const log = argv[3] ? [] : null;
  while (Date.now() < until) {
    const f = ws.frontmostApplication;
    // 目標程式自己，或它生出來的（Godot 的 --path 會直接是同一個 pid）
    if (f && f.processIdentifier === target) {
      // 背景程式呼叫 NSRunningApplication.activate 在新版 macOS 會被「合作式啟用」吃掉，
      // 用 Apple Event 叫它 activate 才穩。
      if (log) log.push(Date.now() + " steal");
      Application(prevId).activate();
      if (log) log.push(Date.now() + " back");
    }
    // 不能用 delay()：frontmostApplication 是靠 run loop 收通知更新的，
    // 沒有跑 run loop 它會永遠停在腳本啟動那一刻的值（第一版就是這樣安靜地失效）。
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.03));
  }
  if (log) $(log.join("\n")).writeToFileAtomicallyEncodingError(argv[3], true, 4, null);
}
JXA
  disown || true
fi
# 直接給 Godot 執行檔的話改走 godot-bg（注入 nofocus.dylib，根本不搶）。上面的切回只能事後補救，
# 每次照樣閃 0.2 秒：2026-10-21 使用者第四次說「godot 測試還是會跳出螢幕」，就是 session 寫了
# `bgrun /Applications/Godot.app/Contents/MacOS/Godot …` 繞過 godot-bg。
nofocus="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/nofocus/godot-bg"
if [ "$(basename "$1")" = Godot ] && [ -x "$nofocus" ] && [ "$1" != "$nofocus" ]; then
  GODOT_REAL="$1" exec "$nofocus" "${@:2}"
fi
exec "$@"
