#!/bin/zsh
#
# quad20 — 在**當下所在的桌面**開一組 Max 20× 的四宮格。
#
# 等同 `quad --claude --20x`：四格都帶 CLAUDE_CONFIG_DIR=~/.claude-work
# （work@example.com，Max 20×），底色換成 Ocean 好跟預設帳號那組分得開。
#
# 預設帳號（you@example.com，Max 5×）那組是冷開機時 .zshrc 的
# quad 掛勾自動排的，不用打任何指令。
#
# 新視窗一律開在打這道指令時所在的那個桌面（Space）——AppleScript 沒有辦法
# 指定 Space，所以要開在桌面 3 就先切到桌面 3 再打。
#
# 既有視窗一個都不碰。
#
set -euo pipefail
exec quad --claude --20x "$@"
