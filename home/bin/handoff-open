#!/usr/bin/env node
// handoff-open — 做完之後自己 /clear、讀交接單接手（2026-10-16；2026-10-17 就地換格；2026-10-20 改成同一格 /clear）。
//
//   handoff-open <交接單.md> [--cwd 目錄]   舊 session 最後一推之後跑：回合結束後同一格自己 /clear 再讀交接單
//   handoff-open <交接單.md> --to <帳號>     同上，但新 session 改用那個帳號（不帶 --to 時由 tools/acct-drain.mjs 判斷）
//   handoff-open <交接單.md> --stay          不管 acct-drain 怎麼說都留在原帳號
//   handoff-open --dry <交接單.md>          只印出會做什麼，不動任何東西
//   handoff-open --inject <標記.json>       （內部）背景等回合結束、對那格打 /clear 與開場白
//   handoff-open --close <標記.json>        （退路用）新格讀完交接單後收掉舊的 claude 與舊格
//   失敗（gaveUp／unconfirmed／背景程序死掉）由 launchd 的 home/bin/handoff-watch 每分鐘讀標記推通知（2026-10-21）
//
// 使用者裁示（切新格的規格在 ~/Projects/agent-quota/docs/iterm2-spec.md 的 C 節，/clear 的在 ~/.claude/skills/handoff/clear-spec.md）：
// - 時機是「這次請求做完的最後一推」之後，中途的 push 不算。
// - 2026-10-20：「每次都自己自動clear再跑交接單」——全面取代切新格；只有打不進字（不在 iTerm2）才退回切新格。
//   做法：起一支脫離的背景程序，等 pane-state 的 Stop hook 把這格寫成 done（回合結束），
//   用 AppleScript write text 打 `/clear`、再打開場白，送出靠 ESC[13u。等 10 分鐘還沒 done 就放棄、不打字。
// - 新 session 讀交接單、跑 /recon，然後直接照「下一步」做下去，沒有重大事件不停下來問（2026-10-19）。
// - 2026-10-21 換帳號：「bruce 用到 90 就先停下改用 peter」——acct-drain 說要換（或帶 --to）時，
//   回合結束後打 /exit 讓這格的 claude 退出，等它真的結束，再在同一格的 shell 打 `eval "$(acct pane peter …)"`。
//   /clear 換不了帳號（同一支 claude、同一個設定目錄），所以這條不走 /clear。
// - 退路（切新格）：新格切在舊格旁邊，新的確認讀到交接單之後才收舊的；收法是結束那格的 shell（SIGHUP）——
//   AppleScript 的 close 會跳確認框卡住（tools/iterm.mjs 有寫）。
import { execFileSync, spawn } from "node:child_process";
import { existsSync, mkdirSync, openSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as IT from "../claude/tools/iterm.mjs";
import { canSwitchHere, claudeAncestor, drainFor, isClaude } from "../claude/tools/acct-drain.mjs";
import * as A from "../claude/tools/accounts.mjs";

const HOME = homedir();
const STATE = join(HOME, ".claude", "state", "handoff");
// 自己的實體路徑（經 ~/.local/bin 的 symlink 叫也一樣）：M5 Pro 的 clone 不在 ~/.claude/skills（PR #10 審查）
const SELF = fileURLToPath(import.meta.url);
const ACCT = existsSync(join(HOME, ".local/bin/acct")) ? "acct" : join(dirname(SELF), "acct");
const PANES = join(HOME, ".claude", "state", "panes");
const WAIT_MS = 10 * 60 * 1000;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
// osa 失敗會丟例外（-1719 已經在 iterm.mjs 每一步各自重試過）：接住回傳錯誤字串，讓呼叫端寫進標記，
// 否則背景程序默默死掉、沒有任何紀錄
const tryOsa = (f) => { try { return f(); } catch (e) { return String(e?.message || e).split("\n")[0]; } };
const die = (m) => { console.error("handoff-open: " + m); process.exit(2); };
// tmux（mani 上的 animyria session，2026-10-20）：用 send-keys 打字，pane 的 tty 給 pane-state 對照
const TMUX_PANE = process.env.TMUX && process.env.TMUX_PANE ? process.env.TMUX_PANE : null;
const tmux = (...a) => execFileSync("tmux", a, { encoding: "utf8" }).trim();
const tmuxAlive = (pane) => { try { return tmux("display", "-p", "-t", pane, "#{pane_id}") === pane; } catch { return false; } };
const tmuxType = (pane, text) => {
  if (!tmuxAlive(pane)) return false;
  if (text) execFileSync("tmux", ["send-keys", "-t", pane, "-l", text]);
  execFileSync("tmux", ["send-keys", "-t", pane, "Enter"]);
  return true;
};
const tmuxShot = (pane) => { try { return tmux("capture-pane", "-p", "-t", pane); } catch { return null; } };

function open(file, cwd, dry, { to = null, stay = false } = {}) {
  if (!TMUX_PANE && (process.platform !== "darwin" || !existsSync(IT.APP))) die("這台沒有 iTerm2 也不在 tmux 裡，交接單照寫、改成手動開新 session");
  const handoff = resolve(file);
  if (!existsSync(handoff)) die(`找不到交接單：${handoff}`);
  const configDir = process.env.CLAUDE_CONFIG_DIR || join(HOME, ".claude");
  const stamp = new Date().toISOString().replace(/[:.]/g, "-");
  const marker = join(STATE, `${stamp}.json`);
  const promptFile = join(STATE, `${stamp}.prompt.md`);
  const old = {
    pid: Number(process.env.HANDOFF_OLD_PID) || claudeAncestor(),   // HANDOFF_OLD_PID：只給驗收用
    uid: IT.sessionUid(),
    term: process.env.TERM_PROGRAM || "",
    handoff, cwd, configDir, created: new Date().toISOString(),
  };
  if (to != null) {
    const { accounts } = A.load(), a = A.find(accounts, to);
    if (!a) die(`帳號清單裡沒有 ${to || "（--to 沒給值）"}（acct 看有哪些）`);
    if (!A.dirFor(accounts, a)) die(`這台沒有任何設定目錄登 ${a.id}，先 acct login ${a.id}`);
    if (A.actual(accounts, configDir)?.id === a.id) die(`這格已經是 ${a.id}，不用換；要清空重來就不要帶 --to`);
  }
  const drain = stay ? null : to ? { to: A.find(A.load().accounts, to).id, reason: "--to " + to } : drainFor(configDir);
  let mode = TMUX_PANE ? "tmux" : old.term === "iTerm.app" && old.uid ? "clear" : "split";
  // 換帳號要先確定舊的 claude 退出了才能對 shell 打字，找不到它的 pid 就不換
  // claude -p 繼承了父格的 ITERM_SESSION_ID，換手會把 /exit 打進父 session：跟 hook 用同一個判斷
  if (mode === "clear" && drain && old.pid && canSwitchHere(process.env, old.pid)) mode = "switch";
  // 明確帶 --to 卻換不了：直接失敗，不要照常 /clear 讓人以為換過了（split 會照 line 開 --to 那個帳號，算換得了）
  if (to && (mode === "clear" || mode === "tmux")) die(`這裡換不了帳號（${mode === "tmux" ? "在 tmux 裡" : "找不到這格的 claude，或這是 claude -p"}），不帶 --to 就照常 /clear`);
  if (mode === "clear" && drain) console.error(`handoff-open: 這裡換不了帳號（找不到這格的 claude，或這是 claude -p；${drain.reason}），照常 /clear`);
  if (TMUX_PANE) old.uid = TMUX_PANE;
  if (drain && mode === "tmux") console.error(`handoff-open: tmux 裡不換帳號（${drain.reason}），照常 /clear`);
  const prompt = [
    `讀交接單 ${handoff}，照它接手上一個 session。`,
    mode === "switch" || (mode === "split" && drain) ? `上一個 session 用的帳號要換掉（${drain.reason}），這個 session 已經改用 ${drain.to}。` : null,
    mode !== "split" ? `工作目錄是 ${cwd}（不一樣就 cd 過去）。` : null,
    mode === "split" ? `讀完之後先跑 \`${SELF} --close ${marker}\` 收掉舊的 session（它會結束舊的 claude、關掉舊格）。` : null,
    "接著跑 /recon。現況跟交接單一致就直接照「下一步」做下去，不用等我下令；",
    "只有重大事件（不可逆／刪資料、花錢、對外發布、要密碼或登入、驗證碼、驗收失敗修不好、現況跟交接單對不上）才停下來用選項問我。",
  ].filter(Boolean).join("\n");
  const who = drain && mode !== "tmux" ? [drain.to] : ["--dir", configDir];
  const line = IT.launchLine(ACCT, [...who, cwd, "--prompt-file", promptFile]);
  if (dry) {
    console.log(JSON.stringify({ mode, old, marker, ...(mode === "split" || mode === "switch" ? { line } : {}), prompt }, null, 2));
    return;
  }
  mkdirSync(STATE, { recursive: true });
  writeFileSync(promptFile, prompt + "\n");
  if (mode === "clear" || mode === "tmux" || mode === "switch") {
    old.tty = mode === "tmux" ? tmux("display", "-p", "-t", TMUX_PANE, "#{pane_tty}") : IT.ttyOf(old.uid);
    writeFileSync(marker, JSON.stringify({ ...old, mode, promptFile, ...(mode === "switch" ? { line, to: drain.to } : {}) }, null, 2));
    const log = join(STATE, `${stamp}.log`);
    const fd = openSync(log, "a");
    const child = spawn(process.execPath, [SELF, "--inject", marker], { detached: true, stdio: ["ignore", fd, fd] });
    child.unref();
    // pid 另寫一檔（不寫進標記：--inject 拿自己讀到的那份整份覆寫標記，會把它蓋掉）；handoff-watch 靠它判斷背景程序是不是死了
    writeFileSync(join(STATE, `${stamp}.pid`), String(child.pid));
    console.log(mode === "switch"
      ? `這一回合結束後，這格的 claude 會退出、改用 ${drain.to} 開新 session 讀交接單接著做（${drain.reason}；標記：${marker}）。現在寫最後的回報、結束回合。`
      : `這一回合結束後，這格會自己 /clear 再讀交接單接著做（標記：${marker}）。現在寫最後的回報、結束回合。`);
    return;
  }
  writeFileSync(marker, JSON.stringify({ ...old, mode }, null, 2));
  const r = IT.splitBeside(null, line);
  writeFileSync(marker, JSON.stringify({ ...old, mode, opened: r }, null, 2));
  console.log(`不在 iTerm2，打不進字：改成在 iTerm2 ${r.how === "split" ? "切新格" : "開新視窗"}接手（標記：${marker}）`);
}

// 背景：等這格的回合結束（pane-state 寫 done），打 /clear，再打開場白
async function inject(marker) {
  const m = JSON.parse(readFileSync(marker, "utf8"));
  try { await injectInner(m, marker); }
  catch (e) {
    // 任何沒接住的例外都要留下結果，不然 handoff-watch 只能靠「程序死了」猜
    Object.assign(m, { gaveUp: "背景程序出錯：" + String(e?.message || e).split("\n")[0] });
    writeFileSync(marker, JSON.stringify(m, null, 2));
  }
}

async function injectInner(m, marker) {
  const tm = m.mode === "tmux";
  const busy = (prev) => { const now = tmuxShot(m.uid); return { changed: now !== prev, now }; };
  const type = (text) => tryOsa(() => (tm ? tmuxType(m.uid, text) : IT.typeInto(m.uid, text)));
  // 送出後 UserPromptSubmit 會把這格寫成 working：n 秒內看到就記 started 回 true
  const waitWorking = async (n) => {
    for (let i = 0; i < n; i++) {
      await sleep(1000);
      const p = paneIs("working", m.prompted);
      if (p) { save({ started: p.updated }); return true; }
    }
    return false;
  };
  const save = (o) => { Object.assign(m, o); writeFileSync(marker, JSON.stringify(m, null, 2)); };
  const paneFile = m.tty ? join(PANES, basename(m.tty) + ".json") : null;
  const pane = () => { try { return JSON.parse(readFileSync(paneFile, "utf8")); } catch { return null; } };
  const after = (p, t) => p && Date.parse(p.updated) > Date.parse(t);
  // pane 檔每次只讀一次：pane-state 寫檔不是原子的、SessionEnd 會刪檔，連讀兩次第二次可能是 null（PR #10 審查）
  const paneIs = (state, since) => { const p = pane(); return after(p, since) && p.state === state ? p : null; };
  if (!paneFile) { save({ gaveUp: "找不到這格的 tty" }); return; }
  const t0 = Date.now();
  while (!paneIs("done", m.created)) {
    if (Date.now() - t0 > WAIT_MS) { save({ gaveUp: "等 10 分鐘回合都沒結束" }); return; }
    await sleep(1000);
  }
  // Stop 的其他 hook（ask-with-options）可能把回合擋回去、Claude 繼續做，但 pane 仍寫著 done：
  // 再要求那格連續 3 秒沒有輸出（工作中 spinner 會一直重畫）才打字
  let shot = tm ? tmuxShot(m.uid) : null;
  for (let quiet = 0; quiet < 3; ) {
    await sleep(1000);
    if (Date.now() - t0 > WAIT_MS) { save({ gaveUp: "等 10 分鐘那格都沒靜下來" }); return; }
    let working;
    if (tm) { const b = busy(shot); shot = b.now; working = b.changed; } else working = IT.isProcessing(m.uid) === true;
    quiet = working || pane()?.state !== "done" ? 0 : quiet + 1;
  }
  if (m.mode === "switch") {
    // 換帳號：讓舊的 claude 退出回到 shell，再在同一格開另一個帳號的 claude（開場白由 --prompt-file 帶進去）
    let r = tryOsa(() => IT.typeInto(m.uid, "/exit"));
    if (r !== true) { save({ gaveUp: r || "找不到那格（session 不見了）" }); return; }
    save({ exited: new Date().toISOString() });
    for (let i = 0; i < 60 && isClaude(m.pid); i++) await sleep(500);
    if (isClaude(m.pid)) { save({ gaveUp: "打了 /exit，舊的 claude 30 秒都沒結束" }); return; }
    // 舊 claude 的 SessionEnd（pane-state end）是 async，會刪這格的狀態檔、還原底色；等它跑完再開新的，
    // 否則它晚到會把新 session 的狀態刪掉（最多等 10 秒，之後照開）
    for (let i = 0; i < 20 && existsSync(paneFile) && !after(pane(), m.exited); i++) await sleep(500);
    await sleep(1000);
    r = tryOsa(() => IT.typeShell(m.uid, m.line));
    if (r !== true) { save({ gaveUp: `舊的 claude 退出了，但打不進新指令：${r || "找不到那格"}` }); return; }
    save({ prompted: new Date().toISOString() });
    if (await waitWorking(40)) return;
    save({ unconfirmed: "新 session 40 秒內沒回報 working，看一下那格" });
    return;
  }
  let r = type("/clear");
  if (r !== true) { save({ gaveUp: typeof r === "string" ? `打不進 /clear：${r}` : "找不到那格（session 不見了）" }); return; }
  save({ cleared: new Date().toISOString() });
  await sleep(3000);   // 等 /clear 跑完、SessionStart hook 跑完
  r = type(`讀 ${m.promptFile} 照做`);
  // 走到這裡那格已經被清空：打不進開場白就是一格閒置的空 session，一定要留結果讓 handoff-watch 叫人
  if (r !== true) { save({ gaveUp: `已經 /clear，但打不進開場白：${typeof r === "string" ? r : "找不到那格"}` }); return; }
  save({ prompted: new Date().toISOString() });
  // 20 秒內沒開工就再送一次 Enter
  if (await waitWorking(20)) return;
  type("");
  save({ retriedEnter: new Date().toISOString() });
  if (await waitWorking(20)) return;
  save({ unconfirmed: "已經 /clear 也打了開場白，補送 Enter 後 20 秒還沒開工，看一下那格" });
}

async function close(marker) {
  let m;
  try { m = JSON.parse(readFileSync(marker, "utf8")); } catch { die(`讀不到標記：${marker}`); }
  if (m.closed) { console.log("舊 session 已經收過了"); return; }
  const me = claudeAncestor();
  const out = [];
  if (m.pid && m.pid !== me && isClaude(m.pid)) {
    process.kill(m.pid, "SIGTERM");
    for (let i = 0; i < 20 && isClaude(m.pid); i++) await new Promise((r) => setTimeout(r, 250));
    out.push(isClaude(m.pid) ? `舊的 claude（pid ${m.pid}）沒有結束` : `已結束舊的 claude（pid ${m.pid}）`);
  } else out.push("舊的 claude 已經不在了");
  // 舊格在 iTerm2 才關得到：結束那格的 shell，窗格自己收
  const tty = m.term === "iTerm.app" && m.uid && m.uid !== IT.sessionUid() ? IT.ttyOf(m.uid) : null;
  if (tty) {
    const pids = execFileSync("ps", ["-t", tty.replace("/dev/", ""), "-o", "pid=,comm="], { encoding: "utf8" })
      .split("\n").filter((l) => /zsh|bash/.test(l)).map((l) => Number(l.trim().split(/\s+/)[0]));
    for (const p of pids) try { process.kill(p, "SIGHUP"); } catch {}
    out.push(`已關掉舊格（${tty}）`);
  } else if (m.term !== "iTerm.app") out.push("舊的在 Terminal.app，視窗留著");
  writeFileSync(marker, JSON.stringify({ ...m, closed: new Date().toISOString() }, null, 2));
  console.log(out.join("；"));
}

const argv = process.argv.slice(2);
const flag = (k) => { const i = argv.indexOf(k); if (i < 0) return null; const v = argv[i + 1]; argv.splice(i, 2); return v; };
if (argv[0] === "--close") await close(argv[1]);
else if (argv[0] === "--inject") await inject(argv[1]);
else {
  const take = (k) => { const i = argv.indexOf(k); if (i >= 0) argv.splice(i, 1); return i >= 0; };
  const dry = take("--dry");
  const stay = take("--stay");
  const hasTo = argv.includes("--to");
  const to = flag("--to");
  if (hasTo && (!to || to.startsWith("--"))) die("--to 後面要接帳號（acct 看有哪些）");
  const cwd = resolve(flag("--cwd") || process.cwd());
  if (!argv[0]) die("用法：handoff-open <交接單.md> [--cwd 目錄] [--to 帳號 | --stay]");
  open(argv[0], cwd, dry, { to, stay });
}
