#!/bin/zsh
#
# quad — 把 Terminal.app 的視窗排成內建螢幕的四宮格。
#
#   quad            把現有視窗重排進四宮格，不足四個就補開
#   quad --auto     給 .zshrc 用：只有「這是唯一的視窗」時才動作，否則靜靜結束
#   quad --dry      只印出算好的座標，不碰任何視窗
#   quad --claude   開四個**全新**視窗、每格在當前目錄跑 claude，排成四宮格
#   quad --auto --claude   掛勾用：只開三個，第四格是觸發的那個視窗本身
#   quad inbox      列出哪一格在等你、等多久；quad inbox <n> 跳過去
#   quad --claude --account=<id>  四格都跑帳號清單上的那個帳號（設定目錄、底色都讀清單）
#   quad --claude --20x    ＝ --account=peter（Max 20×，~/.claude-work，Ocean）
#                          （捷徑：quad20。細節見下面「兩個帳號兩組四宮格」）
#
# --claude 手動跑時一個既有視窗都不碰（不重排、不下指令）。因為打這道指令的
# 視窗常常自己就在跑 Claude Code，對它 do script 等於把 "claude" 這幾個字
# 打進別人的輸入框送出去。寧可多一個視窗被蓋在後面。
#
# 離開碼：0 = 有排　10 = 兩道閘擋下來什麼都沒做（--auto 時掛勾靠這個判斷）
#
# 為什麼是腳本而不是 Terminal 內建的「視窗群組」：視窗群組記的是**死座標**，
# 外接螢幕拔掉之後會把視窗排到不存在的位置。這裡每次都重新問 NSScreen，
# 接什麼螢幕、Dock 在哪邊、Dock 有沒有自動隱藏，算出來都是對的。
#
# 座標系統有兩套，這是這支腳本最容易寫錯的地方：
#   - NSScreen 用 Cocoa 座標，原點在**主螢幕左下角**，y 向上長
#   - Terminal 的 AppleScript `bounds` 原點在**主螢幕左上角**，y 向下長
# 轉換公式在 geometry() 裡，H0 是主螢幕高度。
#
set -euo pipefail

LOCK="${TMPDIR:-/tmp}/.quad.lock"
LOCK_TTL=5   # 秒。這個時間窗內只允許觸發一次。

# ---------------------------------------------------------------- 幾何

# 印出四宮格的 AppleScript bounds，一行一格：left top right bottom
geometry() {
  osascript -l JavaScript <<'JXA'
ObjC.import('AppKit');

const screens = ObjC.unwrap($.NSScreen.screens);
// screens[0] 永遠是掛選單列的那個螢幕，也就是 AppleScript 座標的原點所在。
const H0 = screens[0].frame.size.height;

// 找內建螢幕。找不到（例如闔蓋外接使用）就退回主螢幕——
// 硬要排在一個不存在的螢幕上，結果是四個視窗消失在畫面外。
let target = screens.find((s) =>
  /built-?in|color lcd|liquid retina/i.test(ObjC.unwrap(s.localizedName)));
if (!target) target = screens[0];

// visibleFrame 已經扣掉選單列與 Dock，正是我們要的可用範圍。
const vf = target.visibleFrame;
const left   = vf.origin.x;
const right  = vf.origin.x + vf.size.width;
const top    = H0 - (vf.origin.y + vf.size.height);
const bottom = H0 - vf.origin.y;

const midX = Math.round(left + (right - left) / 2);
const midY = Math.round(top + (bottom - top) / 2);
const L = Math.round(left), R = Math.round(right);
const T = Math.round(top),  B = Math.round(bottom);

// 左上、右上、左下、右下
[
  [L, T, midX, midY],
  [midX, T, R, midY],
  [L, midY, midX, B],
  [midX, midY, R, B],
].map((q) => q.join(' ')).join('\n');
JXA
}

window_count() {
  osascript -e 'tell application "Terminal" to count windows' 2>/dev/null || echo 0
}

# ---------------------------------------------------------------- 開新視窗（--claude 用）

# 把字串包成 AppleScript 字面值能吃的樣子。反斜線要先處理，不然會把
# 自己剛加上去的跳脫字元再跳脫一次。
as_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  print -r -- "$s"
}

# 開一個新視窗跑 cmd，印出它的 window id。
#
# 為什麼要 id 不用 `window 1`：新視窗會插到最前面，既有視窗的索引整個往後飄。
# 用索引排版就會排到別人的視窗上。id 是視窗自己的身分，不隨前後順序變。
# `id of front window` 跟 do script 在同一個 osascript 裡完成，中間沒有空隙。
open_window() {
  local cmd
  cmd=$(as_escape "$1")
  osascript -e "tell application \"Terminal\"
    do script \"${cmd}\"
    id of front window
  end tell"
}

# 用 id 設 bounds。失敗不中斷——視窗可能已經被使用者關掉了。
place_window() {
  local id=$1 l=$2 t=$3 r=$4 b=$5
  osascript -e "tell application \"Terminal\" to set bounds of (first window whose id is ${id}) to {${l}, ${t}, ${r}, ${b}}" \
    >/dev/null 2>&1 || true
}

# 換視窗的設定檔（底色）。失敗不中斷——設定檔名打錯或被刪掉時，寧可
# 四個視窗長得跟預設一樣，也不要整支腳本死在這裡、留下排到一半的版面。
style_window() {
  local id=$1 profile=$2 bg=${3:-}
  osascript -e "tell application \"Terminal\" to set current settings of (first window whose id is ${id}) to settings set \"${profile}\"" \
    >/dev/null 2>&1 || true
  # 自動配色的帳號（第三個以後）沒有專屬設定檔，在設定檔上再蓋一層底色
  if [[ $bg == \#?????? ]]; then
    local r=$(( 16#${bg[2,3]} * 257 )) g=$(( 16#${bg[4,5]} * 257 )) b=$(( 16#${bg[6,7]} * 257 ))
    osascript -e "tell application \"Terminal\" to set background color of selected tab of (first window whose id is ${id}) to {${r}, ${g}, ${b}}" \
      >/dev/null 2>&1 || true
  fi
}

# ---------------------------------------------------------------- 旗標

# quad inbox：哪一格在等你（狀態由 hooks/pane-state.mjs 回報，2026-10-06）
if [[ "${1:-}" == inbox ]]; then
  shift
  exec node "${0:A:h}/quad-inbox" "$@"
fi

MODE=manual
CLAUDE=0
ACCOUNT_ID=''
for arg in "$@"; do
  case "$arg" in
    --auto)   MODE=auto ;;
    --dry)    MODE=dry ;;
    --claude) CLAUDE=1 ;;
    --20x)    ACCOUNT_ID=peter; CLAUDE=1 ;;
    --account=*) ACCOUNT_ID=${arg#--account=}; CLAUDE=1 ;;
    -h|--help) sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) print -u2 "quad: 不認得的參數 $arg"; exit 2 ;;
  esac
done

# ------------------------------------------- 兩個帳號兩組四宮格（2026-09-18）
#
# 這台 Air 上兩個 Claude 帳號靠 CLAUDE_CONFIG_DIR 並存（見
# ~/.claude/memory/claude-two-accounts-same-mac.md）：
#
#   ~/.claude            you@example.com  Max 5×   ← 預設，冷開機那組
#   ~/.claude-work   work@example.com           Max 20×  ← --20x 這組
#
# --20x 只做兩件事：每格的指令前面加上那個環境變數，以及把四個視窗的
# 設定檔換成 Ocean（5× 那組是 Red Sands）。**底色是唯一看得出來的差別**——claude 會把終端機標題
# 改成自己的狀態，所以標題標不住，只有 profile 留得下來。
#
# --auto 永遠不帶 --20x：冷開機自動跳出來的那組固定開在 ~/.claude，帳號看它現在登誰。
# 20× 那組是手動的，因為它要開在哪個桌面（Space）由你決定——新視窗一律
# 開在**當下所在的那個桌面**，AppleScript 沒有辦法指定 Space。
CONFIG_ENV=''
PROFILE=''
# 2026-10-06 改成一冷一暖：5× 用暖色 Red Sands（磚紅），20× 維持冷色 Ocean。
# 只套在 quad 開出來跑 claude 的視窗；使用者自己另開的 Terminal 維持預設。
# 等待色也跟著分冷暖，定義在 hooks/pane-state.mjs。
# 2026-10-06 起帳號資料改讀帳號清單（home/claude/accounts/<LocalHostName>.json），
# 不再寫死在這裡。--20x 等於 --account=peter；只寫 --claude 等於清單上 ~/.claude 那個帳號。
ACCTLIB="${0:A:h}/../claude/tools/accounts.mjs"
WORK_BG=''
if (( CLAUDE )); then
  # 2026-10-10 起「登入哪個帳號就算哪個帳號」：
  #   沒指定帳號 → 開在 ~/.claude，配色看它現在實際登誰
  #   指定帳號   → 開在現在登著那個帳號的目錄；這台沒有目錄登它就不開（開出來會是別人）
  if [[ -z $ACCOUNT_ID ]]; then
    CONFIG_DIR=$HOME/.claude
  else
    node "$ACCTLIB" get "$ACCOUNT_ID" id >/dev/null || { print -u2 "quad: 帳號清單上沒有 $ACCOUNT_ID"; exit 2; }
    CONFIG_DIR=$(node "$ACCTLIB" dir-for "$ACCOUNT_ID") || { print -u2 "quad: 這台沒有任何設定目錄登 $ACCOUNT_ID，先 acct login $ACCOUNT_ID"; exit 2; }
  fi
  if [[ ! -d $CONFIG_DIR ]]; then
    print -u2 "quad: 找不到 $CONFIG_DIR（用 acct add 建）"
    exit 2
  fi
  [[ $CONFIG_DIR != "$HOME/.claude" ]] && CONFIG_ENV="CLAUDE_CONFIG_DIR=${(qq)CONFIG_DIR} "
  PROFILE=$(node "$ACCTLIB" get-for-dir "$CONFIG_DIR" colors.work_profile)
  WORK_BG=$(node "$ACCTLIB" get-for-dir "$CONFIG_DIR" colors.work_bg)
fi

# --auto --claude 是掛勾用的組合（2026-08-06 起）：冷啟動時四格各跑一個 claude。
#
# 為什麼這不是 fork bomb：被開出來的三個視窗也會跑 .zshrc 打到這支腳本，
# 但那時視窗數已經是 2/3/4，閘二就把它們擋掉了。閘門擋的是「視窗數」，
# 跟每格裡面跑什麼無關，所以加 claude 沒有讓防護變弱。
#
# 但代價是真的：每次冷啟動固定開四個 claude session。要停就 NOQUAD=1。

[[ -n "${NOQUAD:-}" ]] && exit 0

# 每格要跑的指令。cd 失敗就收掉那格——~/Documents 底下有 iCloud 同步的
# EPERM 問題，cd 掛掉時繼續跑 claude 會讓它在 $HOME 啟動、看錯專案。
# 這裡只 exit 那個 shell，不影響其他三格。
#
# 這裡刻意跑「裸的 claude」，不塞任何環境變數。四格都會照 SessionStart 掛勾
# 的設定在你打第一句話時先訪談你——那是使用者要的。
# （2026-08-06 曾經加過 QUAD_NO_GRILL=1 想擋掉自動訪談，但那是建立在錯誤前提上：
#   沒有人輸入時 claude 根本不會動，SessionStart 只塞 context 不會讓模型自己跑。
#   同一天拆掉了。不要再加回來。）
if (( CLAUDE )); then
  CLAUDE_CMD="cd ${(qq)PWD} || exit; ${CONFIG_ENV}claude"
fi

if [[ $MODE == dry ]]; then
  print "四宮格座標（left top right bottom）："
  geometry | nl -w4 -s'  '
  print "目前視窗數：$(window_count)"
  if (( CLAUDE )); then
    print -r -- "--claude：開四個新視窗，每格跑"
    print -r -- "  $CLAUDE_CMD"
    [[ -n $PROFILE ]] && print -r -- "設定檔（底色）：$PROFILE"
    print -r -- "既有視窗完全不動。"
  fi
  exit 0
fi

# ---------------------------------------------------------------- 自動模式的兩道閘

# 離開碼的約定（掛勾靠這個決定自己要不要接著跑 claude）：
#   0  = 有排（掛勾接著在自己這格跑 claude）
#   10 = 兩道閘之一擋下來，什麼都沒做（掛勾必須安靜結束）
# 用 10 不用 1 是為了跟真正的錯誤（osascript 掛掉之類）分得開。
DECLINE=10

if [[ $MODE == auto ]]; then
  # 閘一：時間鎖。就算視窗計數在競態下判斷錯，最多也只多開一輪——
  # 我不想留一個要靠 killall Terminal 收場的東西。
  if [[ -f $LOCK ]]; then
    NOW=$(date +%s)
    STAMP=$(stat -f %m "$LOCK" 2>/dev/null || echo 0)
    (( NOW - STAMP < LOCK_TTL )) && exit $DECLINE
  fi

  # 閘二：只有「畫面上沒有別的視窗」時才排。被開出來的那三個視窗跑到這行時
  # 視窗數已經是 2、3、4，會在這裡結束——遞迴就是斷在這裡。
  # 這一條跟每格裡面跑什麼無關，所以 --claude 併進來也擋得住。
  (( $(window_count) > 1 )) && exit $DECLINE

  : > "$LOCK"
fi

# ---------------------------------------------------------------- 排版

typeset -a QUADS
QUADS=("${(@f)$(geometry)}")

# --claude 有兩條路，差別在「觸發的那個視窗算不算一格」：
#
#   手動（quad --claude）——開四個全新視窗，既有視窗一個都不碰。
#     打指令的那個視窗常常自己就在跑 Claude Code，對它 do script 等於
#     把字打進別人的輸入框。寧可多一個視窗被蓋在後面。
#
#   掛勾（quad --auto --claude）——只開三個，第四格就是觸發的那個視窗本身。
#     這裡安全，因為閘二保證「現在畫面上只有這一個視窗」，而它是個剛開機、
#     還在跑 .zshrc 的空 shell，不可能有東西在裡面。腳本不對它下指令
#     （子行程做不到），只把它排進左上格，claude 由掛勾自己接手跑。
#     不這樣做就會變成 5 個視窗：觸發的那個空 shell + 4 個 claude。
if (( CLAUDE )); then
  typeset -a IDS
  if [[ $MODE == auto ]]; then
    # 閘二剛保證過視窗數 == 1，所以 window 1 就是自己。
    IDS=("$(osascript -e 'tell application "Terminal" to id of window 1')")
    for _ in {1..3}; do
      IDS+=("$(open_window "$CLAUDE_CMD")")
    done
  else
    for _ in {1..4}; do
      IDS+=("$(open_window "$CLAUDE_CMD")")
    done
  fi

  for i in {1..4}; do
    b=(${=QUADS[$i]})
    place_window "${IDS[$i]}" "${b[1]}" "${b[2]}" "${b[3]}" "${b[4]}"
    [[ -n $PROFILE ]] && style_window "${IDS[$i]}" "$PROFILE" "$WORK_BG"
  done

  # 焦點收回左上格，不然會停在最後開的右下格。
  osascript -e "tell application \"Terminal\" to set index of (first window whose id is ${IDS[1]}) to 1" \
    >/dev/null 2>&1 || true
  exit 0
fi

CURRENT=$(window_count)

# 不足四個就補開。超過四個不關任何視窗——關視窗可能弄丟正在跑的東西，
# 那個代價遠高於「第五個視窗沒被排進格子」。
if (( CURRENT < 4 )); then
  for _ in {$((CURRENT + 1))..4}; do
    osascript -e 'tell application "Terminal" to do script ""' >/dev/null
  done
fi

# 依 Terminal 自己的視窗順序（前到後）填格子：左上、右上、左下、右下。
# 不猜「哪個視窗該放哪」——沒有可靠的依據，猜錯比照順序排更煩。
for i in {1..4}; do
  b=(${=QUADS[$i]})
  osascript -e "tell application \"Terminal\" to set bounds of window $i to {${b[1]}, ${b[2]}, ${b[3]}, ${b[4]}}" \
    >/dev/null 2>&1 || true
done
