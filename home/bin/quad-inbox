#!/usr/bin/env node
// quad inbox — 列出哪一格在等你、等多久（借 tuios 的 Inbox，2026-10-06）。
//
//   quad inbox        列出全部 session，等你的排前面、等最久的排第一
//   quad inbox <n>    跳到第 n 個（把那個 Terminal 分頁帶到最前面）
//   quad inbox -w     只列等你的（needs_input／done）
//
// 資料來源：hooks/pane-state.mjs 寫的 ~/.claude/state/panes/<tty>.json。
// 狀態檔的 pid 已經不在、或 tty 上已經沒有 claude 的，視為殘骸直接刪掉——
// session 被 Ctrl+C 或關視窗殺掉時 SessionEnd 不一定會跑到。
import { execFileSync } from "node:child_process";
import { readdirSync, readFileSync, unlinkSync } from "node:fs";
import { homedir } from "node:os";
import { join, basename } from "node:path";

const DIR = join(homedir(), ".claude", "state", "panes");
const LABEL = { needs_input: "等你回答", done: "做完了等你", working: "工作中" };
const RANK = { needs_input: 0, done: 1, working: 2 };

function alive(pid) {
  try { process.kill(pid, 0); return true; } catch { return false; }
}

function ago(iso) {
  const s = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 1000));
  if (s < 60) return `${s} 秒`;
  if (s < 3600) return `${Math.floor(s / 60)} 分`;
  return `${Math.floor(s / 3600)} 時 ${Math.floor((s % 3600) / 60)} 分`;
}

function load() {
  let names = [];
  try { names = readdirSync(DIR).filter((f) => f.endsWith(".json")); } catch {}
  const out = [];
  for (const f of names) {
    const p = join(DIR, f);
    try {
      const s = JSON.parse(readFileSync(p, "utf8"));
      if (!s.pid || !alive(s.pid)) { unlinkSync(p); continue; }
      out.push(s);
    } catch { try { unlinkSync(p); } catch {} }
  }
  out.sort((a, b) => (RANK[a.state] ?? 9) - (RANK[b.state] ?? 9) || Date.parse(a.since) - Date.parse(b.since));
  return out;
}

function jump(tty) {
  execFileSync("osascript", ["-e", `tell application "Terminal"
  repeat with w in windows
    repeat with t in tabs of w
      if tty of t is "${tty}" then
        set selected of t to true
        set index of w to 1
        activate
        return
      end if
    end repeat
  end repeat
end tell`]);
}

const args = process.argv.slice(2);
const onlyWaiting = args.includes("-w");
let rows = load();
if (onlyWaiting) rows = rows.filter((r) => r.state !== "working");
const n = args.find((a) => /^\d+$/.test(a));

if (n) {
  const r = rows[Number(n) - 1];
  if (!r) { console.error(`沒有第 ${n} 個（目前 ${rows.length} 個）`); process.exit(1); }
  jump(r.tty);
  process.exit(0);
}

if (!rows.length) {
  console.log(onlyWaiting ? "沒有 session 在等你。" : "沒有回報中的 session（hook 還沒觸發過，或都關了）。");
  process.exit(0);
}
const waiting = rows.filter((r) => r.state !== "working").length;
console.log(`${waiting} 格在等你／共 ${rows.length} 個 session　（quad inbox <n> 跳過去）\n`);
rows.forEach((r, i) => {
  const mark = r.state === "needs_input" ? "●" : r.state === "done" ? "○" : "·";
  const acct = String(r.account || "?").padEnd(6);
  console.log(
    `${String(i + 1).padStart(2)}  ${mark} ${(LABEL[r.state] || r.state).padEnd(6, "　")} ${ago(r.since).padStart(9)}  ${acct}  ${basename(r.tty).padEnd(8)} ${basename(r.cwd || "")}` +
    (r.state === "needs_input" && r.message ? `\n      ${r.message.slice(0, 90)}` : "")
  );
});
